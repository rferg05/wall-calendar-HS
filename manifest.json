{
  "id": "wall-calendar",
  "name": "Wall Calendar",
  "version": "1.3.0",
  "description": "This week, this week and next, or the month, with every event's title readable from across the room over any background photo. Merges duplicates across calendars and marks events you share.",
  "author": "Ryan",
  "license": "MIT",
  "minAppVersion": "1.7.1",
  "moduleType": "wall-calendar",
  "category": "Calendar",
  "icon": "calendar-days",
  "defaultConfig": {
    "view": "twoWeeks",
    "weekStart": "sunday",
    "layout": "auto",
    "showHeader": true,
    "showTime": true,
    "showLocation": false,
    "titleLines": 2,
    "colorBy": "calendar",
    "mergeDuplicates": true,
    "sharedStyle": "split",
    "sharedColor": "#a855f7",
    "chipStyle": "tinted",
    "dayBackground": "#080a0e",
    "dayBackdrop": 70,
    "dayBlur": 0,
    "dayBorderWidth": 0,
    "dayBorderColor": "#64748b",
    "textOutline": true,
    "pastStyle": "gray",
    "showHolidays": true,
    "customHolidayColor": false,
    "holidayColor": "#ef4444",
    "showBirthdays": true,
    "hideWords": "",
    "textScale": 1,
    "accentColor": "#3b82f6",
    "timeFormat": "auto"
  },
  "defaultSize": {
    "w": 1280,
    "h": 720
  },
  "defaultStyle": {
    "fontSize": 16,
    "padding": 12,
    "backgroundColor": "rgba(0, 0, 0, 0.35)"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "view": {
        "type": "string",
        "title": "Show",
        "enum": [
          "week",
          "twoWeeks",
          "month"
        ],
        "enumLabels": [
          "This week",
          "This week and next",
          "This month"
        ],
        "ui:widget": "select",
        "ui:group": "View"
      },
      "weekStart": {
        "type": "string",
        "title": "Weeks start on",
        "description": "Today makes the week views start with today and run 7 or 14 days ahead. The month always starts on Sunday or Monday.",
        "enum": [
          "sunday",
          "monday",
          "today"
        ],
        "enumLabels": [
          "Sunday",
          "Monday",
          "Today"
        ],
        "ui:widget": "select",
        "ui:group": "View"
      },
      "layout": {
        "type": "string",
        "title": "Week layout",
        "description": "Week views only. Auto picks whichever allows the larger text for the module's shape: days side by side in a wide module, one day per row in a narrow or tall one.",
        "enum": [
          "auto",
          "columns",
          "rows"
        ],
        "enumLabels": [
          "Auto (by module shape)",
          "Days side by side",
          "One day per row"
        ],
        "ui:widget": "select",
        "ui:group": "View"
      },
      "showHeader": {
        "type": "boolean",
        "title": "Month / dates heading",
        "ui:widget": "toggle",
        "ui:group": "View"
      },
      "showTime": {
        "type": "boolean",
        "title": "Start times",
        "ui:widget": "toggle",
        "ui:group": "Events"
      },
      "showLocation": {
        "type": "boolean",
        "title": "Location",
        "description": "Under the title, when days are side by side. The part before the first comma.",
        "ui:widget": "toggle",
        "ui:group": "Events"
      },
      "titleLines": {
        "type": "number",
        "title": "Lines per event title",
        "description": "On a busy day, long titles are cut to this many lines so more events fit. A quiet day shows whole titles. A day with more events than fit shows \"+2 more\".",
        "minimum": 1,
        "maximum": 4,
        "ui:widget": "slider",
        "ui:step": 1,
        "ui:group": "Events"
      },
      "colorBy": {
        "type": "string",
        "title": "Color events by",
        "description": "Person uses each family member's color from Settings > Family, for calendars linked to them.",
        "enum": [
          "calendar",
          "person"
        ],
        "enumLabels": [
          "Calendar color",
          "Person"
        ],
        "ui:widget": "select",
        "ui:group": "Events"
      },
      "mergeDuplicates": {
        "type": "boolean",
        "title": "Merge duplicate events",
        "description": "Shows one event for copies that start within 15 minutes of each other with nearly the same title, like \"Reservation at Avec\" and \"Reservation: Avec\". Off merges only exact copies.",
        "ui:widget": "toggle",
        "ui:group": "Events"
      },
      "sharedStyle": {
        "type": "string",
        "title": "Events you share",
        "description": "An event on more than one person's calendar. Both colors puts one person's color on each end. People are told apart by Settings > Family, with each person's calendars linked to them; calendars linked to no one count as separate people.",
        "enum": [
          "split",
          "color"
        ],
        "enumLabels": [
          "Both colors",
          "One color of their own"
        ],
        "ui:widget": "select",
        "ui:group": "Events"
      },
      "sharedColor": {
        "type": "string",
        "title": "Shared event color",
        "ui:widget": "color",
        "ui:group": "Events",
        "ui:showWhen": {
          "field": "sharedStyle",
          "equals": "color"
        }
      },
      "chipStyle": {
        "type": "string",
        "title": "Event style",
        "description": "All-day events are always filled, so they stand apart from timed ones.",
        "enum": [
          "tinted",
          "solid"
        ],
        "enumLabels": [
          "Dark with a color bar",
          "Filled with the color"
        ],
        "ui:widget": "select",
        "ui:group": "Events"
      },
      "pastStyle": {
        "type": "string",
        "title": "Past events",
        "description": "Events that have ended, today and earlier. Gray out keeps a dimmed bar of the event's color, so you can still tell whose it was. Earlier days' names and dates fade too, unless this is Leave as is.",
        "enum": [
          "gray",
          "fade",
          "hide",
          "none"
        ],
        "enumLabels": [
          "Gray out",
          "Fade",
          "Hide",
          "Leave as is"
        ],
        "ui:widget": "select",
        "ui:group": "Events"
      },
      "showHolidays": {
        "type": "boolean",
        "title": "Holidays",
        "ui:widget": "toggle",
        "ui:group": "Events"
      },
      "customHolidayColor": {
        "type": "boolean",
        "title": "Own color for holidays",
        "description": "Off uses the holiday calendar's color from Settings > Calendar.",
        "ui:widget": "toggle",
        "ui:group": "Events",
        "ui:showWhen": {
          "field": "showHolidays",
          "equals": true
        }
      },
      "holidayColor": {
        "type": "string",
        "title": "Holiday color",
        "ui:widget": "color",
        "ui:group": "Events",
        "ui:showWhen": {
          "field": "customHolidayColor",
          "equals": true
        }
      },
      "showBirthdays": {
        "type": "boolean",
        "title": "Birthdays",
        "ui:widget": "toggle",
        "ui:group": "Events"
      },
      "hideWords": {
        "type": "string",
        "title": "Hide events whose title contains",
        "description": "Comma-separated, e.g. \"Busy, Tentative\".",
        "ui:widget": "text",
        "ui:group": "Events"
      },
      "dayBackground": {
        "type": "string",
        "title": "Background color",
        "description": "Each day's card. A dark color keeps white text readable over bright photos.",
        "ui:widget": "color",
        "ui:group": "Day cards"
      },
      "dayBackdrop": {
        "type": "number",
        "title": "Background strength (%)",
        "description": "How strongly the background color covers the photo behind each day: 0 is clear, 100 is solid. Raise it if a background washes the calendar out. Today's card is always at least 62%, so its ring stands out.",
        "minimum": 0,
        "maximum": 100,
        "ui:widget": "slider",
        "ui:step": 5,
        "ui:group": "Day cards"
      },
      "dayBlur": {
        "type": "number",
        "title": "Frosted glass (blur)",
        "description": "Blurs the photo behind each day's card, like the module's own Backdrop blur, so text reads over a busy background even at a low strength. 0 is off. Heavy blur on many cards can slow an older Pi.",
        "minimum": 0,
        "maximum": 30,
        "ui:widget": "slider",
        "ui:step": 1,
        "ui:group": "Day cards"
      },
      "dayBorderWidth": {
        "type": "number",
        "title": "Border thickness (px)",
        "description": "0 is no border.",
        "minimum": 0,
        "maximum": 8,
        "ui:widget": "slider",
        "ui:step": 1,
        "ui:group": "Day cards"
      },
      "dayBorderColor": {
        "type": "string",
        "title": "Border color",
        "ui:widget": "color",
        "ui:group": "Day cards"
      },
      "textScale": {
        "type": "number",
        "title": "Text size",
        "description": "Text already grows with the module. This makes it larger or smaller from there; larger fits fewer events per day.",
        "minimum": 0.5,
        "maximum": 2,
        "ui:widget": "slider",
        "ui:step": 0.05,
        "ui:group": "Legibility"
      },
      "textOutline": {
        "type": "boolean",
        "title": "Outline day names and dates",
        "ui:widget": "toggle",
        "ui:group": "Legibility"
      },
      "accentColor": {
        "type": "string",
        "title": "Today color",
        "ui:widget": "color",
        "ui:group": "Legibility"
      },
      "timeFormat": {
        "type": "string",
        "title": "Clock times",
        "enum": [
          "auto",
          "12h",
          "24h"
        ],
        "enumLabels": [
          "Household setting",
          "12-hour",
          "24-hour"
        ],
        "ui:widget": "select",
        "ui:group": "Legibility"
      }
    }
  },
  "exports": {
    "component": "default"
  },
  "dataRequirements": [
    "calendar"
  ],
  "prefetchUrl": null,
  "permissions": []
}
